{
  "appId": "com.okstudio.macrovox",
  "productName": "MacroVox",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/icons",
      "to": "icons"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.ico",
    "signtoolOptions": {
      "publisherName": "OK Studio Inc.",
      "certificateSha1": "fc22b5221318f3f3f6b3eb2d969d7f99091557bf",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "sign": "build/sign.js"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": true,
    "allowElevation": true,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "deleteAppDataOnUninstall": true,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "menuCategory": "MacroVox",
    "shortcutName": "MacroVox",
    "guid": "macrovox-standalone",
    "include": "build/installer.nsh"
  }
}
