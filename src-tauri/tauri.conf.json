{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacroVox",
  "version": "1.0.6",
  "identifier": "com.okstudio.macrovox",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "dictation.html",
        "title": "MacroVox",
        "width": 380,
        "height": 360,
        "minWidth": 380,
        "minHeight": 360,
        "decorations": false,
        "alwaysOnTop": true,
        "backgroundColor": "#0f172a",
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Settings — MacroVox",
        "width": 480,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500,
        "alwaysOnTop": true,
        "backgroundColor": "#0a0f14",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://hlioqbizljywisvnbtat.supabase.co https://macrovox.netlify.app https://api.deepgram.com wss://api.deepgram.com; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/okstudio1/MacroVox/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "headerImage": "installer/windows/installer-header.bmp",
        "sidebarImage": "installer/windows/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "startMenuFolder": "MacroVox",
        "installerHooks": "installer/windows/installer-hooks.nsh"
      }
    }
  }
}
