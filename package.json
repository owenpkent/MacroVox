{
  "name": "macrovox",
  "version": "1.0.6",
  "description": "MacroVox — Voice Dictation for Windows",
  "main": "dist/main/main.js",
  "author": "OK Studio",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npx tsc -p config/tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "clean:main": "node -e \"const fs=require('fs');const p=require('path');try{fs.rmSync(p.join(__dirname,'dist','main'),{recursive:true,force:true});fs.rmSync(p.join(__dirname,'config','tsconfig.main.tsbuildinfo'),{force:true})}catch(e){}\"",
    "build:main": "npm run clean:main && npx tsc -p config/tsconfig.main.json",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --config build/electron-builder.json",
    "package:dev": "npm run build && electron-builder --config build/electron-builder.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
