# Copy this file to `.env` and fill in the values.
# Vite embeds any `VITE_*` var into the renderer bundle at build time,
# so rebuild the renderer (`npm run build:renderer`) after changing these.

# ── Supabase (REQUIRED — app crashes to a black window without these) ─────────
# Project URL (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=https://hlioqbizljywisvnbtat.supabase.co
# Publishable / anon key — safe to ship in client code
VITE_SUPABASE_KEY=

# ── Dev-only key bypass (OPTIONAL) ───────────────────────────────────────────
# When VITE_DEV_MODE=true AND the build is a dev build, the renderer uses the
# direct API keys below instead of the Netlify proxy. Production builds ignore
# these regardless of the value. Never commit real keys.
VITE_DEV_MODE=false
VITE_DEEPGRAM_KEY=
VITE_ANTHROPIC_KEY=
